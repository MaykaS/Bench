# Local mode is the default without server credentials. Production uses cloud mode.
NEXT_PUBLIC_BENCH_STORAGE=local
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Secret key: server only, never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
# Exact origin used for pairing links and same-origin write protection.
BENCH_ORIGIN=http://localhost:3000
